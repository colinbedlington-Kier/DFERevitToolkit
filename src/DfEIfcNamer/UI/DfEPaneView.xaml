<Window x:Class="DfEIfcNamer.UI.DfEFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DfE IFC Namer" Height="700" Width="950" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding DocumentStatus}"/>
            <StatusBarItem Content="{Binding MappingLoadedStatus}"/>
            <StatusBarItem Content="{Binding LastSyncStatus}"/>
        </StatusBar>
        <TabControl>
            <TabItem Header="Setup">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check Parameters" Width="140" Margin="0,0,8,0" Command="{Binding CheckParametersCommand}"/>
                        <Button Content="Assign Parameters" Width="140" Command="{Binding AssignParametersCommand}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                        <TextBlock Text="Parameter status" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SetupStatus}" Margin="0,4,0,0"/>
                        <TextBlock Text="Setup diagnostics" FontWeight="Bold" Margin="0,12,0,4"/>
                        <TextBlock Text="{Binding CoverageStatus}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Included Categories" Margin="0,12,0,4" FontWeight="Bold"/>
                        <ListBox ItemsSource="{Binding Categories}" Height="180">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Parameter assignment results" Margin="0,12,0,4" FontWeight="Bold"/>
                        <DataGrid ItemsSource="{Binding ParameterResults}" AutoGenerateColumns="False" IsReadOnly="True" Height="180">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="170"/>
                                <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedBindingType}" Width="80"/>
                                <DataGridTextColumn Header="In SP File" Binding="{Binding FoundInSharedParameterFile}" Width="70"/>
                                <DataGridTextColumn Header="Insert" Binding="{Binding InsertSucceeded}" Width="60"/>
                                <DataGridTextColumn Header="ReInsert" Binding="{Binding ReInsertSucceeded}" Width="70"/>
                                <DataGridTextColumn Header="Verified" Binding="{Binding FinalBoundState}" Width="70"/>
                                <DataGridTextColumn Header="Action" Binding="{Binding BindingAction}" Width="90"/>
                                <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Sync with COBie">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Source IFCName (instance)" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding InstanceSource}" Grid.Row="0" Grid.Column="1"/>

                    <TextBlock Text="Target COBie.Component.Name" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding InstanceTargetOptions}" SelectedItem="{Binding InstanceTarget}" Grid.Row="1" Grid.Column="1"/>

                    <TextBlock Text="Source IFCName [Type]" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TypeSource}" Grid.Row="2" Grid.Column="1"/>

                    <TextBlock Text="Target COBie.Type.Name" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                    <ComboBox ItemsSource="{Binding TypeTargetOptions}" SelectedItem="{Binding TypeTarget}" Grid.Row="3" Grid.Column="1"/>

                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <TextBlock Text="Scope" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding ScopeOptions}" SelectedItem="{Binding SelectedScope}" Width="220"/>
                        <TextBlock Text="Overwrite mode" FontWeight="Bold" Margin="0,8,0,0"/>
                        <ComboBox ItemsSource="{Binding OverwriteOptions}" SelectedItem="{Binding SelectedOverwrite}" Width="260"/>
                        <TextBlock Text="Results log" FontWeight="Bold" Margin="0,8,0,4"/>
                        <ListBox ItemsSource="{Binding Logs}" Height="220"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Reload Mapping" Width="120" Margin="0,0,8,0" Command="{Binding ReloadMappingCommand}"/>
                        <Button Content="Save + Apply" Width="120" Command="{Binding SaveAndApplyCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="About">
                <StackPanel Margin="8">
                    <TextBlock Text="DfE IFC Namer" FontSize="16" FontWeight="Bold"/>
                    <TextBlock Text="Setup and Sync with COBie mappings." Margin="0,8,0,12"/>
                    <Button Content="Exit" Width="100" Command="{Binding ExitCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
