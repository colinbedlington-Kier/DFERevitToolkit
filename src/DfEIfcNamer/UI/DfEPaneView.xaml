<Window x:Class="DfEIfcNamer.UI.DfEFloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DfE IFC Authoring Tool" Height="760" Width="1220" WindowStartupLocation="CenterOwner"
        FontFamily="Poppins, Arial" FontSize="12" Background="#FFFFFF">
    <Window.Resources>
        <SolidColorBrush x:Key="FailBackgroundBrush" Color="#FFF4CCCC"/>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#E8EEF1"/>
            <Setter Property="Foreground" Value="#00263A"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007B86"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>
        <Style x:Key="ComplianceCellBorderStyle" TargetType="Border">
            <Setter Property="Padding" Value="2,0,2,0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style x:Key="ComplianceIfcNameBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HighlightIfcName}" Value="True">
                    <Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ComplianceIfcTypeNameBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightIfcTypeName}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComplianceIfcEntityBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightIfcEntity}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComplianceIfcPredefinedBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightIfcPredefinedType}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComplianceAdsBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightAdsClassification}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComplianceSystemBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightSystemName}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComplianceZoneBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightZoneName}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ComplianceActualValueBorderStyle" TargetType="Border" BasedOn="{StaticResource ComplianceCellBorderStyle}">
            <Style.Triggers><DataTrigger Binding="{Binding HighlightActualValue}" Value="True"><Setter Property="Background" Value="{StaticResource FailBackgroundBrush}"/></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding DocumentStatus}"/>
            <StatusBarItem Content="{Binding GlobalStatus}"/>
        </StatusBar>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="DfE IFC Authoring Tool" FontSize="18" FontWeight="SemiBold" Foreground="#00263A" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                <Image x:Name="KierLogoImage"
                       Width="120"
                       Height="36"
                       Stretch="Uniform"
                       Source="pack://application:,,,/DfEIfcNamer;component/Resources/Brand/kier_logo.png"
                       Margin="0,0,8,0"
                       ImageFailed="KierLogoImage_ImageFailed"/>
                <TextBlock x:Name="KierLogoFallbackText"
                           Text="Kier logo unavailable"
                           Visibility="Collapsed"
                           FontSize="10"
                           Foreground="#3D4543"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <TabControl>
            <TabItem Header="Setup">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="220"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Check Setup" Command="{Binding Setup.CheckSetupCommand}"/>
                        <Button Content="Create Missing Parameters" Command="{Binding Setup.CreateMissingParametersCommand}"/>
                        <Button Content="Load Naming Code Map" Command="{Binding Setup.LoadNamingCodeMapCommand}"/>
                        <Button Content="Load System List" Command="{Binding Setup.LoadSystemListCommand}"/>
                        <Button Content="Export Setup Report" Command="{Binding Setup.ExportSetupReportCommand}"/>
                        <Button Content="Copy Debug Report" Command="{Binding Setup.CopyDebugReportCommand}"/>
                    </WrapPanel>
                    <StackPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Setup.Status}" FontWeight="Bold" Foreground="#00263A"/>
                        <TextBlock Text="{Binding Setup.NamingCodeStatus}"/>
                        <TextBlock Text="{Binding Setup.SystemListStatus}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Setup.ParameterStatuses}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parameter Name" Binding="{Binding ParameterName}" Width="220"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="90"/>
                            <DataGridCheckBoxColumn Header="In Shared File" Binding="{Binding FoundInSharedParameterFile}" Width="90"/>
                            <DataGridTextColumn Header="Shared Group" Binding="{Binding SharedParameterGroup}" Width="120"/>
                            <DataGridTextColumn Header="Actual Scope" Binding="{Binding ActualScope}" Width="90"/>
                            <DataGridCheckBoxColumn Header="Exists" Binding="{Binding Exists}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Writable" Binding="{Binding Writable}" Width="90"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="90"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <GroupBox Header="Status Summary" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ListBox ItemsSource="{Binding Setup.Log}"/></ScrollViewer>
                        </GroupBox>
                        <GroupBox Header="Warnings" Grid.Column="1" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ListBox ItemsSource="{Binding Setup.WarningLog}"/></ScrollViewer>
                        </GroupBox>
                        <GroupBox Header="Diagnostics / Errors" Grid.Column="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Setup.DebugStatus}" FontWeight="Bold" Margin="0,0,0,6" Foreground="#DA242A" TextWrapping="Wrap"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><ListBox ItemsSource="{Binding Setup.DebugLines}"/></ScrollViewer>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Object Naming">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="100"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <TextBlock Text="Scope" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="220" ItemsSource="{Binding Naming.ScopeModes}" SelectedItem="{Binding Naming.ScopeMode}" Margin="0,0,8,8"/>
                        <TextBlock Text="Numbering" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox Width="160" ItemsSource="{Binding Naming.NumberingModes}" SelectedItem="{Binding Naming.NumberingMode}" Margin="0,0,8,8"/>
                        <CheckBox Content="Use fallback code" IsChecked="{Binding Naming.UseFallbackCode}" Margin="0,0,8,8"/>
                        <TextBox Width="70" Text="{Binding Naming.FallbackCode}" Margin="0,0,8,8"/>
                        <CheckBox Content="Allow door/window unassigned fallback" IsChecked="{Binding Naming.AllowDoorWindowUnassignedFallback}"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1">
                        <Button Content="Generate Proposed Names" Command="{Binding Naming.GeneratePreviewCommand}"/>
                        <Button Content="Validate" Command="{Binding Naming.ValidateCommand}"/>
                        <Button Content="Select All" Command="{Binding Naming.SelectAllRowsCommand}"/>
                        <Button Content="Unselect All" Command="{Binding Naming.UnselectAllRowsCommand}"/>
                        <Button Content="Refresh" Command="{Binding Naming.RefreshCommand}"/>
                        <Button Content="Apply Filters" Command="{Binding Naming.ApplyFiltersCommand}"/>
                        <Button Content="Fill-down IFC Predefined Type" Command="{Binding Naming.FillDownPredefinedTypeCommand}"/>
                        <Button Content="Apply Instance Data" Command="{Binding Naming.ApplyIfcNameCommand}"/>
                        <Button Content="Apply Type Data" Command="{Binding Naming.ApplyIfcTypeCommand}"/>
                        <Button Content="Apply All" Command="{Binding Naming.ApplyAllCommand}"/>
                        <Button Content="Export Naming Report" Command="{Binding Naming.ExportReportCommand}"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="2">
                        <TextBlock Text="Element Id" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="70" Text="{Binding Naming.FilterElementId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding Naming.FilterCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Family" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding Naming.FilterFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding Naming.FilterType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="IFC Entity" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding Naming.FilterIfcEntity, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="IFC Predefined" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="120" Text="{Binding Naming.FilterIfcPredefinedType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Fill value" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="120" Text="{Binding Naming.FillDownIfcPredefinedType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Naming.FilteredRows}" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="100"/>
                            <DataGridTextColumn Header="Current IFCName" Binding="{Binding CurrentIfcName}" Width="120"/>
                            <DataGridTextColumn Header="Proposed IFCName" Binding="{Binding ProposedIfcName}" Width="120"/>
                            <DataGridTextColumn Header="Current IFCName[Type]" Binding="{Binding CurrentIfcTypeName}" Width="120"/>
                            <DataGridTextColumn Header="Proposed IFCName[Type]" Binding="{Binding ProposedIfcTypeName}" Width="140"/>
                            <DataGridTextColumn Header="Proposed IFC Entity" Binding="{Binding ProposedIfcEntity}" Width="120"/>
                            <DataGridComboBoxColumn Header="Proposed IFC Predefined Type" SelectedItemBinding="{Binding ProposedIfcPredefinedType, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="." SelectedValuePath="." Width="170">
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding AllowedIfcPredefinedTypes}"/>
                                        <Setter Property="IsEditable" Value="True"/>
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="ItemsSource" Value="{Binding AllowedIfcPredefinedTypes}"/>
                                        <Setter Property="IsEditable" Value="True"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="4"><TextBlock Text="{Binding Naming.Status}" FontWeight="Bold"/><ListBox ItemsSource="{Binding Naming.Warnings}"/></StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="System Assignment">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Auto-Resolve" Command="{Binding SystemAssignment.AutoResolveCommand}"/>
                        <Button Content="Validate" Command="{Binding SystemAssignment.ValidateCommand}"/>
                        <Button Content="Select All" Command="{Binding SystemAssignment.SelectAllCommand}"/>
                        <Button Content="Unselect All" Command="{Binding SystemAssignment.UnselectAllCommand}"/>
                        <Button Content="Apply Filters" Command="{Binding SystemAssignment.ApplyFiltersCommand}"/>
                        <Button Content="Apply" Command="{Binding SystemAssignment.ApplyCommand}"/>
                        <Button Content="Report / Export" Command="{Binding SystemAssignment.ExportCommand}"/>
                        <CheckBox Content="Add as Next System" IsChecked="{Binding SystemAssignment.AddAsNextSystem}" Margin="0,0,8,8"/>
                        <TextBlock Text="Suggested systems" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <ComboBox Width="240" ItemsSource="{Binding SystemAssignment.SuggestedSystems}" DisplayMemberPath="DisplayText" SelectedValuePath="SystemName" SelectedValue="{Binding SystemAssignment.SelectedSuggestedSystem}" Margin="0,0,8,8"/>
                        <TextBlock Text="All allowed systems" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <ComboBox Width="220" ItemsSource="{Binding SystemAssignment.AllAllowedSystems}" SelectedItem="{Binding SystemAssignment.SelectedAllowedSystem}" Margin="0,0,8,8"/>
                        <TextBlock Text="User-defined Name" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Width="220" Text="{Binding SystemAssignment.UserDefinedName, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Description" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Width="260" Text="{Binding SystemAssignment.UserDefinedDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Filter" VerticalAlignment="Center" Margin="8,0,4,0"/>
                        <TextBox Width="160" Text="{Binding SystemAssignment.RowFilterText, UpdateSourceTrigger=PropertyChanged}"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1">
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding SystemAssignment.FilterCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Family" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding SystemAssignment.FilterFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding SystemAssignment.FilterType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Ss Number" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="100" Text="{Binding SystemAssignment.FilterSsNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Resolved System" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="140" Text="{Binding SystemAssignment.FilterResolvedSystem, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" Margin="0,34,0,0" ItemsSource="{Binding SystemAssignment.FilteredRows}" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected}" Width="60"/>
                            <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Uniclass Ss Number" Binding="{Binding SourceSsNumber}" Width="150"/>
                            <DataGridTextColumn Header="Matched Prefix" Binding="{Binding MatchedSystemPrefix}" Width="120"/>
                            <DataGridTextColumn Header="Candidate Systems" Binding="{Binding CandidateSystems}" Width="220"/>
                            <DataGridTextColumn Header="Resolved System" Binding="{Binding ProposedSystemName}" Width="180"/>
                            <DataGridTextColumn Header="System Description" Binding="{Binding ProposedSystemDescription}" Width="200"/>
                            <DataGridTextColumn Header="System Category" Binding="{Binding ProposedSystemCategory}" Width="220"/>
                            <DataGridCheckBoxColumn Header="USERDEFINED" Binding="{Binding IsUserDefinedSystem}" Width="95"/>
                            <DataGridTextColumn Header="Validation Error" Binding="{Binding UserDefinedValidationError}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding SystemAssignment.Status}" FontWeight="Bold" Foreground="#00263A"/>
                </Grid>
            </TabItem>

            <TabItem Header="IFC Header Data">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="120"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <GroupBox Header="Project" Margin="0,0,8,8">
                        <StackPanel Margin="8">
                            <TextBlock Text="IfcProjectName"/><TextBox Text="{Binding HeaderData.IfcProjectName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="IfcProjectDescription" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.IfcProjectDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Site" Grid.Column="1" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <TextBlock Text="IfcSiteName"/><TextBox Text="{Binding HeaderData.IfcSiteName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="IfcSiteDescription" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.IfcSiteDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Building" Grid.Row="1" Margin="0,0,8,8">
                        <StackPanel Margin="8">
                            <TextBlock Text="IfcBuildingName"/><TextBox Text="{Binding HeaderData.IfcBuildingName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="IfcBuildingDescription" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.IfcBuildingDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="Additional Metadata" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <TextBlock Text="UPRN"/><TextBox Text="{Binding HeaderData.UPRN, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="MaximumBlockHeight" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.MaximumBlockHeight, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="NumberOfStoreys (Project)" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.NumberOfStoreys, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Phase (Project)" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.Phase, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="BlockConstructionType (Project)" Margin="0,8,0,0"/><TextBox Text="{Binding HeaderData.BlockConstructionType, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </GroupBox>
                    <WrapPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <Button Content="Read From Model" Command="{Binding HeaderData.ReadFromModelCommand}"/>
                        <Button Content="Validate" Command="{Binding HeaderData.ValidateCommand}"/>
                        <Button Content="Apply Project Data" Command="{Binding HeaderData.WriteToModelCommand}"/>
                        <Button Content="Save Template" Command="{Binding HeaderData.SaveTemplateCommand}"/>
                        <Button Content="Load Template" Command="{Binding HeaderData.LoadTemplateCommand}"/>
                        <Button Content="Export Header Summary" Command="{Binding HeaderData.ExportSummaryCommand}"/>
                        <TextBlock Text="{Binding HeaderData.Status}" VerticalAlignment="Center"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Space &amp; Zone Assignment">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Load Selection" Command="{Binding SpaceZone.LoadSelectionCommand}"/>
                        <Button Content="Resolve Rooms/Spaces" Command="{Binding SpaceZone.ResolveRoomsCommand}"/>
                        <Button Content="Select All" Command="{Binding SpaceZone.SelectAllRowsCommand}"/>
                        <Button Content="Unselect All" Command="{Binding SpaceZone.UnselectAllRowsCommand}"/>
                        <Button Content="Refresh" Command="{Binding SpaceZone.RefreshCommand}"/>
                        <TextBlock Text="Zone" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="220" DisplayMemberPath="Name" SelectedValuePath="Name" Text="{Binding SpaceZone.ProposedZoneName, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ItemsSource="{Binding SpaceZone.Zones}" Margin="0,0,8,8"/>
                        <TextBlock Text="ADS" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="260" DisplayMemberPath="DisplayText" SelectedValuePath="DisplayText" Text="{Binding SpaceZone.ProposedAdsClassification, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" ItemsSource="{Binding SpaceZone.AdsClassifications}" Margin="0,0,8,8"/>
                        <Button Content="Apply Room Data (SpaceReference)" Command="{Binding SpaceZone.ApplySpaceReferenceCommand}"/>
                        <Button Content="Apply Zone" Command="{Binding SpaceZone.ApplyZoneNameCommand}"/>
                        <Button Content="Apply ADS" Command="{Binding SpaceZone.ApplyAdsCommand}"/>
                        <Button Content="Validate Assignment" Command="{Binding SpaceZone.ValidateAssignmentCommand}"/>
                        <Button Content="Export Assignment Report" Command="{Binding SpaceZone.ExportReportCommand}"/>
                    </WrapPanel>
                    <WrapPanel Grid.Row="1">
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="90" Text="{Binding SpaceZone.FilterCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Family" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="90" Text="{Binding SpaceZone.FilterFamily, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="90" Text="{Binding SpaceZone.FilterType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Room" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="90" Text="{Binding SpaceZone.FilterRoom, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <TextBlock Text="Zone" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox Width="90" Text="{Binding SpaceZone.FilterZone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,8"/>
                        <Button Content="Apply Filters" Command="{Binding SpaceZone.ApplyFiltersCommand}"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" Margin="0,34,0,0" ItemsSource="{Binding SpaceZone.FilteredRows}" AutoGenerateColumns="False" IsReadOnly="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Room Number" Binding="{Binding RoomNumber}" Width="90"/>
                            <DataGridTextColumn Header="Current ADS Classification" Binding="{Binding CurrentAdsClassification}" Width="220"/>
                            <DataGridTextColumn Header="Proposed ADS" Binding="{Binding ProposedAdsClassification}" Width="220"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="{Binding SpaceZone.Status}" FontWeight="Bold"/>
                </Grid>
            </TabItem>

            <TabItem Header="Classification Sync">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="80"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Preview Mapping" Command="{Binding ClassificationSync.GeneratePreviewCommand}"/>
                        <Button Content="Apply Sync" Command="{Binding ClassificationSync.ApplyCommand}" IsEnabled="{Binding ClassificationSync.CanApply}"/>
                    </WrapPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ClassificationSync.Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                            <DataGridTextColumn Header="Type Id" Binding="{Binding TypeElementId}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="100"/>
                            <DataGridTextColumn Header="Pr Number" Binding="{Binding SourcePrNumber}" Width="100"/>
                            <DataGridTextColumn Header="Ss Number" Binding="{Binding SourceSsNumber}" Width="100"/>
                            <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding ClassificationSync.Status}" FontWeight="Bold" Foreground="#DA242A" TextWrapping="Wrap"/>
                        <ListBox ItemsSource="{Binding ClassificationSync.Warnings}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="COBie Sync / Validation">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <WrapPanel>
                        <Button Content="Run Validation" Command="{Binding Validation.RunValidationCommand}"/>
                        <Button Content="Sync COBie Parameters" Command="{Binding Validation.SyncCobieCommand}"/>
                        <Button Content="Export Validation Report" Command="{Binding Validation.ExportReportCommand}"/>
                    </WrapPanel>
                    <UniformGrid Grid.Row="1" Columns="2" Margin="0,8,0,8">
                        <TextBlock Text="Setup readiness:" FontWeight="Bold"/><TextBlock Text="{Binding Validation.SetupReadiness}"/>
                        <TextBlock Text="Naming completeness:" FontWeight="Bold"/><TextBlock Text="{Binding Validation.NamingCompleteness}"/>
                        <TextBlock Text="Header completeness:" FontWeight="Bold"/><TextBlock Text="{Binding Validation.HeaderCompleteness}"/>
                        <TextBlock Text="Space/Zone completeness:" FontWeight="Bold"/><TextBlock Text="{Binding Validation.SpaceZoneCompleteness}"/>
                    </UniformGrid>
                    <StackPanel Grid.Row="2">
                        <TextBlock Text="{Binding Validation.Status}" FontWeight="Bold" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding Validation.Messages}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="DfE Compliance Validation">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Summary">
                        <UniformGrid Columns="4" Margin="8">
                            <TextBlock Text="Total elements checked:" FontWeight="Bold"/><TextBlock Text="{Binding ComplianceValidation.TotalElementsChecked}"/>
                            <TextBlock Text="Compliant elements:" FontWeight="Bold"/><TextBlock Text="{Binding ComplianceValidation.CompliantElementsCount}"/>
                            <TextBlock Text="Non-compliant elements:" FontWeight="Bold"/><TextBlock Text="{Binding ComplianceValidation.NonCompliantElementsCount}"/>
                            <TextBlock Text="Total failed checks:" FontWeight="Bold"/><TextBlock Text="{Binding ComplianceValidation.TotalFailedChecks}"/>
                            <TextBlock Text="Element Compliance %:" FontWeight="Bold"/><TextBlock Text="{Binding ComplianceValidation.ElementCompliancePercent}"/>
                            <TextBlock Text="Rule Compliance %:" FontWeight="Bold"/><TextBlock Text="{Binding ComplianceValidation.RuleCompliancePercent}"/>
                            <TextBlock Text="Metric definition:" FontWeight="Bold"/><TextBlock Grid.ColumnSpan="3" Text="{Binding ComplianceValidation.MetricDefinition}" TextWrapping="Wrap"/>
                        </UniformGrid>
                    </GroupBox>

                    <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding ComplianceValidation.Categories}" SelectedItem="{Binding ComplianceValidation.SelectedCategory}" Margin="0,0,8,8"/>
                        <TextBlock Text="Family" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding ComplianceValidation.Families}" SelectedItem="{Binding ComplianceValidation.SelectedFamily}" Margin="0,0,8,8"/>
                        <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding ComplianceValidation.Types}" SelectedItem="{Binding ComplianceValidation.SelectedType}" Margin="0,0,8,8"/>
                        <TextBlock Text="Rule Group" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="150" ItemsSource="{Binding ComplianceValidation.RuleGroups}" SelectedItem="{Binding ComplianceValidation.SelectedRuleGroup}" Margin="0,0,8,8"/>
                        <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Width="160" ItemsSource="{Binding ComplianceValidation.StatusModes}" SelectedItem="{Binding ComplianceValidation.SelectedStatusMode}" Margin="0,0,8,8"/>
                        <Button Content="Refresh / Revalidate" Command="{Binding ComplianceValidation.RunValidationCommand}"/>
                        <Button Content="View in 3D Model" Command="{Binding ComplianceValidation.ViewIn3DCommand}"/>
                        <Button Content="Select All" Command="{Binding ComplianceValidation.SelectAllCommand}"/>
                        <Button Content="Unselect All" Command="{Binding ComplianceValidation.UnselectAllCommand}"/>
                    </WrapPanel>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding ComplianceValidation.FilteredRows}" AutoGenerateColumns="False" CanUserSortColumns="True" SelectionMode="Extended" SelectionUnit="FullRow">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Element Id" Binding="{Binding ElementId}" Width="90"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110"/>
                            <DataGridTextColumn Header="Family" Binding="{Binding Family}" Width="120"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="90"/>
                            <DataGridTemplateColumn Header="Current IFC Name" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceIfcNameBorderStyle}">
                                            <TextBlock Text="{Binding CurrentIfcName}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current IFC Name [Type]" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceIfcTypeNameBorderStyle}">
                                            <TextBlock Text="{Binding CurrentIfcTypeName}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current IFC Entity" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceIfcEntityBorderStyle}">
                                            <TextBlock Text="{Binding CurrentIfcEntity}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current IFC Predefined Type" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceIfcPredefinedBorderStyle}">
                                            <TextBlock Text="{Binding CurrentIfcPredefinedType}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current ADS Classification" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceAdsBorderStyle}">
                                            <TextBlock Text="{Binding CurrentAdsClassification}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current System Name" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceSystemBorderStyle}">
                                            <TextBlock Text="{Binding CurrentSystemName}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Current Zone Name" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceZoneBorderStyle}">
                                            <TextBlock Text="{Binding CurrentZoneName}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Rule Group" Binding="{Binding RuleGroup}" Width="110"/>
                            <DataGridTextColumn Header="Rule / Check Name" Binding="{Binding RuleName}" Width="160"/>
                            <DataGridTextColumn Header="Expected Value / Requirement" Binding="{Binding ExpectedRequirement}" Width="200"/>
                            <DataGridTemplateColumn Header="Actual Value" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ComplianceActualValueBorderStyle}">
                                            <TextBlock Text="{Binding ActualValue}" TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                            <DataGridTextColumn Header="Notes / Failure Reason" Binding="{Binding Notes}" Width="220"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="3" Text="{Binding ComplianceValidation.Status}" FontWeight="Bold" Margin="0,8,0,0"/>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
