<UserControl x:Class="DfEIfcNamer.UI.DfEPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid Margin="10">
        <TabControl>
            <TabItem Header="Types">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="120" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,8,0"/>
                        <ComboBox Width="180" ItemsSource="{Binding IfcEntities}" SelectedItem="{Binding SelectedIfcEntity}" Margin="0,0,8,0"/>
                        <ComboBox Width="180" ItemsSource="{Binding PredefinedTypes}" SelectedItem="{Binding SelectedPredefinedType}" Margin="0,0,8,0"/>
                        <TextBox Width="180" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding TypeRows}" AutoGenerateColumns="False" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="IFC Class" Binding="{Binding IfcClassToken}"/>
                            <DataGridTextColumn Header="Predefined" Binding="{Binding PredefinedType}"/>
                            <DataGridTextColumn Header="User Defined" Binding="{Binding UserDefinedValue}"/>
                            <DataGridTextColumn Header="Preview" Binding="{Binding PreviewIfcTypeName}" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Conflict" Binding="{Binding HasConflict}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Audit CSV" Width="100" Margin="0,0,8,0" Command="{Binding ExportAuditCommand}"/>
                        <Button Content="Apply" Width="100" Command="{Binding ApplyTypesCommand}"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Instances">
                <StackPanel Margin="8">
                    <TextBlock Text="Scope"/>
                    <ComboBox Width="180" ItemsSource="{Binding InstanceScopes}" SelectedItem="{Binding SelectedScope}" Margin="0,0,0,8"/>
                    <TextBlock Text="Numbering Mode"/>
                    <ComboBox Width="180" ItemsSource="{Binding NumberingModes}" SelectedItem="{Binding SelectedNumberingMode}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding InstancePreview}" Margin="0,0,0,8"/>
                    <Button Content="Apply" Width="100" HorizontalAlignment="Right" Command="{Binding ApplyInstancesCommand}"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Project">
                <StackPanel Margin="8">
                    <TextBlock Text="JSON Configuration" FontWeight="Bold"/>
                    <TextBox Height="220" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding ProjectConfigJson, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Load" Width="80" Margin="0,0,8,0" Command="{Binding LoadConfigCommand}"/>
                        <Button Content="Save" Width="80" Margin="0,0,8,0" Command="{Binding SaveConfigCommand}"/>
                        <Button Content="Reset Counters" Width="120" Command="{Binding ResetCountersCommand}"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Export/Audit">
                <StackPanel Margin="8">
                    <Button Content="Export IFC (DfE Preset)" Width="180" Margin="0,0,0,8" Command="{Binding ExportIfcCommand}"/>
                    <Button Content="Export Audit CSV" Width="180" Command="{Binding ExportAuditCommand}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
